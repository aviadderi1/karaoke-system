{
  "name": "karaoke-system",
  "productName": "Karaoke Lab",
  "version": "1.0.1",
  "description": "Karaoke subtitle studio with YouTube import and vocal removal.",
  "author": "AD SOUND & SERVICE",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "castv2-client": "^1.2.0",
    "electron-updater": "^6.3.9",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.adsound.karaokesystem",
    "productName": "Karaoke Lab",
    "copyright": "© AD SOUND & SERVICE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "cast.js",
      "server.js",
      "preload.js",
      "lyrics-preload.js",
      "lyrics-browser.html",
      "splash.html",
      "app/**",
      "build/icon.png",
      "build/splash.jpg",
      "build/letters_mask.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "aviadderi1",
        "repo": "karaoke-system",
        "releaseType": "release"
      }
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Karaoke-Lab-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karaoke Lab",
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Karaoke-Lab-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Karaoke Lab ${version}",
      "writeUpdateInfo": false
    }
  }
}
